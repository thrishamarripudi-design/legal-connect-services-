# Application Environment Variables
APP_URL="http://localhost:3000"
PORT=3000

# JWT Authentication
JWT_SECRET="replace-with-256-bit-random-secret-key"
JWT_EXPIRATION_MS=86400000

# MySQL 8 (Spring Boot Backend)
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="legalconnect"
DB_USER="legalconnect_user"
DB_PASSWORD="change_me_strong_password"

# Document Storage
UPLOAD_DIR="./uploads"
STORAGE_PROVIDER="local"
CLOUDINARY_URL=""

# SMTP Email (JavaMailSender)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME="no-reply@legalconnect.example"
MAIL_PASSWORD="change_me_app_password"

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
PAYMENT_MODE="mock"

# Vite Frontend
VITE_API_BASE_URL="/api/v1"
